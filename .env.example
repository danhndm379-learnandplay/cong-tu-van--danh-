# Sao chép file này thành .env.local rồi điền giá trị thật khi bắt đầu nối backend (Tuần 3+).
# Ở bản UI hiện tại (Tuần 1), toàn bộ dữ liệu là mock — chưa cần các biến này để chạy `npm run dev`.

# Supabase (Tuần 3). Lịch sử chat lưu ở bảng riêng tư conversations/messages, CHỈ truy cập từ server.
# SUPABASE_SECRET_KEY bỏ qua RLS: tuyệt đối không đặt tên bắt đầu bằng NEXT_PUBLIC_ và không commit giá trị thật.
# Lấy ở Supabase Dashboard → Project Settings → API Keys. Trên Vercel phải thêm SUPABASE_URL và SUPABASE_SECRET_KEY.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# SUPABASE_PUBLISHABLE_KEY dùng để đọc dữ liệu CÔNG KHAI (trường, học bổng) với quyền tối thiểu và để ĐĂNG NHẬP bằng magic link
# (/login) — thiếu thì đăng nhập không dùng được. Phải đặt cả trên Vercel. (Đọc dữ liệu công khai nếu thiếu thì tạm dùng SUPABASE_SECRET_KEY.)
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=

# Khu vực /admin yêu cầu đăng nhập bằng email + mật khẩu (Supabase Auth) và tài khoản phải có app_metadata.role = "admin".
# Không có biến môi trường riêng cho admin và không có trang đăng ký: tạo tài khoản bằng `node scripts/create-admin.mjs <email>`.
# Cần SUPABASE_URL + SUPABASE_PUBLISHABLE_KEY (đăng nhập) và SUPABASE_SECRET_KEY (đọc dữ liệu khách ở server).

# URL công khai của site, dùng cho magic link đăng nhập (Tuần 6) và metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gemini (Tuần 2: chatbot QnA) — lấy key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Tuỳ chọn cho /api/chat (đã có giá trị mặc định)
# GEMINI_DOC_MODEL=gemini-3.1-flash-lite       # đọc giấy tờ học viên (đa phương thức)
# GEMINI_ADVISOR_MODEL=gemini-3.1-flash-lite   # gợi ý học bổng (function calling)
# GEMINI_LEAD_MODEL=gemini-3.1-flash-lite   # model trích xuất lead ở admin
# GEMINI_LEAD_THINKING_LEVEL=LOW
# GEMINI_THINKING_LEVEL=MINIMAL        # MINIMAL | LOW | MEDIUM | HIGH
# CHAT_RATE_LIMIT_PER_MIN=10           # số request/phút cho mỗi IP
# CHAT_GLOBAL_RATE_LIMIT_PER_MIN=12   # tổng request/phút của cả site (gói free Gemini: tối đa 15/phút)

# Webhook Make.com: mỗi yêu cầu báo giá mới được lưu sẽ POST (tên, email, gói, giá) tới URL này.
# Để trống = không gửi. Cần https. KHÔNG ghi URL thật vào code/commit; trên Vercel phải thêm biến này.
QUOTE_WEBHOOK_URL=

# Webhook Make.com thứ hai: khi admin bấm Duyệt một yêu cầu báo giá, gửi (tên, email, link đăng nhập) tới URL này.
# Để trống = không gửi và nút Duyệt báo lỗi cấu hình (yêu cầu giữ nguyên "chờ duyệt"). Cần https; không commit URL thật.
QUOTE_APPROVED_WEBHOOK_URL=
# Link đăng nhập gửi cho khách. Để trống = dùng <NEXT_PUBLIC_SITE_URL>/login (hoặc địa chỉ website hiện tại).
# Khi có trang đăng nhập thật chỉ cần đổi giá trị này (và Redeploy), không cần sửa gì ở Make.
QUOTE_LOGIN_URL=

# (Tuỳ chọn, chỉ để ghi nhớ) Gmail App Password dùng cho Supabase SMTP: nhập ở Supabase Dashboard → Authentication → SMTP Settings.
# Code của site không đọc biến này. Không commit giá trị thật.
# SUPABASE_SMTP_APP_PASSWORD=
